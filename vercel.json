{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "rewrites": [
        {
            "source": "/api/assessment",
            "destination": "/api/assessment"
        },
        {
            "source": "/api/health",
            "destination": "/api/health"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}